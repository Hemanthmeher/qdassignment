# PaySwift sandbox base URL (required)
PAYSWIFT_BASE_URL=http://localhost:8081

# Database connection URL (defaults to local sqlite for zero-dependency local runs, or postgres in docker)
DATABASE_URL=sqlite:///./quickdrop.db

# Groq API configuration (openai/gpt-oss-120b)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional Gemini API key
GEMINI_API_KEY=

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
